# Copy this file to .env and fill in real values. Never commit the real .env file.

DATABASE_URL="file:./prisma/crm.db"

# Required — the app refuses to start without a secret of at least 16 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

NODE_ENV="development"

# "mock" = no external AI calls, deterministic simulated responses (default for local dev).
# "live" = real calls to Fireworks (requires FIREWORKS_API_KEY).
FIREWORKS_MODE="mock"
FIREWORKS_API_KEY=""
FIREWORKS_MODEL="accounts/fireworks/models/llama-v3p3-70b-instruct"

# Only used by the seed script — change before any real deployment.
SEED_ADMIN_EMAIL="admin@crm.com"
SEED_ADMIN_PASSWORD="admin123"
